{
  "name": "micmute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build --config config/vite.config.ts",
    "tauri": "tauri",
    "test": "vitest run --config config/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config config/eslint.config.js . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "cargo fmt --manifest-path src/core/Cargo.toml -- --check && cargo clippy --manifest-path src/core/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src/core/Cargo.toml --locked",
    "check": "npm run check:frontend && npm run lint:rust && npm run test:rust",
    "check:frontend": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "description": "macOS menu bar app that mutes the system microphone with a shortcut and shows a red screen border while muted",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranvirsingh/micmute.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  }
}
